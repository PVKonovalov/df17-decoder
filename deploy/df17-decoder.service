# systemd unit for df17-decoder. Install (see README "Running as a service"):
#   sudo install -m 755 df17-decoder /usr/local/bin/
#   sudo install -D -m 644 config/config.yaml /etc/df17-decoder/config.yaml
#   sudo install -m 644 deploy/df17-decoder.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now df17-decoder
[Unit]
Description=df17-decoder Mode S / ADS-B decoder and web UI
Documentation=https://github.com/PVKonovalov/df17-decoder
Wants=network-online.target
After=network-online.target dump1090-fa.service

[Service]
ExecStart=/usr/local/bin/df17-decoder -config /etc/df17-decoder/config.yaml
Restart=on-failure
RestartSec=5s
# Exit code 2 is a config error: fix the file instead of restarting in a loop.
RestartPreventExitStatus=2

# Unprivileged throwaway user. The only writable place is the state directory /var/lib/df17-decoder,
# which is also the working directory, so a relative coverage.file (coverage.json) and history.file
# (history.db, with its -wal and -shm files) are kept there.
DynamicUser=yes
StateDirectory=df17-decoder
WorkingDirectory=%S/df17-decoder
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# A listen port below 1024 (e.g. api.listen ":80") also needs:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
